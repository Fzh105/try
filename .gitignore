# .gitignore
venv/
__pycache__/
*.pyc
*.db # 如果还有旧的 .db 文件
.streamlit/ # 忽略本地 secrets

# .gitignore 文件内容示例

# 虚拟环境
venv/
.venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 本地 Streamlit Secrets
.streamlit/

# 之前的 SQLite 数据库文件 (如果还存在)
*.db
*.db-journal

# IDE/编辑器配置文件 (可选)
.idea/
.vscode/

# 其他你不想推送的文件...
